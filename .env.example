# Use / for a same-origin /api reverse proxy, or set the backend origin.
VITE_API_BASE_URL=http://localhost:8080
# Optional local Vite proxy target when VITE_API_BASE_URL=/ (never a production proxy).
VITE_API_PROXY_TARGET=
# The application always uses the real API. The sample business adapter exists only inside Vitest fixtures and is
# never reachable from `npm run dev`, any staging profile or production. API failures never fall back to samples.

# Static staging build ONLY: RACEHORSE_STAGING_MODE=preview or api (not a secret). `sample` is retired.
# preview = protected non-production Preview with a role test login that has NO server authority.
# api = real login; requires a public HTTPS VITE_API_BASE_URL and rejects the role test login and sample flags.
# Never put passwords, JWTs, SQL strings or secrets in VITE_* variables.
# Vercel Production only, after Leader approval: RACEHORSE_APPROVED_RELEASE_SHA=<exact main commit SHA>.
# This is a non-secret build interlock, not a substitute for Independent Gate or branch protection.
