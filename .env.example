# Use / for a same-origin /api reverse proxy, or set the backend origin.
VITE_API_BASE_URL=http://localhost:8080
# Optional local Vite proxy target when VITE_API_BASE_URL=/ (never a production proxy).
VITE_API_PROXY_TARGET=
# Explicit temporary business adapter: api (default) or sample. Authentication/health/restriction APIs stay real.
# API failures NEVER change this setting. No role selector or preview authentication is provided.
VITE_BUSINESS_DATA_SOURCE=api
