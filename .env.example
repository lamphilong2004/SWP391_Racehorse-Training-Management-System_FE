# Use / for a same-origin /api reverse proxy, or set the backend origin.
VITE_API_BASE_URL=http://localhost:8080
# Optional local Vite proxy target when VITE_API_BASE_URL=/ (never a production proxy).
VITE_API_PROXY_TARGET=
# Explicit temporary business adapter: api (default) or sample. Authentication/health/restriction APIs stay real.
# API failures NEVER change this setting. No role selector or preview authentication is provided.
VITE_BUSINESS_DATA_SOURCE=api

# Static staging build ONLY: RACEHORSE_STAGING_MODE=sample or api (not a secret).
# npm run build:staging. Sample profile sets its own isolated flags and needs no Backend.
# API profile requires a public HTTPS VITE_API_BASE_URL and rejects sample/harness flags.
# Never put passwords, JWTs, SQL strings or secrets in VITE_* variables.
# Vercel Production only, after Leader approval: RACEHORSE_APPROVED_RELEASE_SHA=<exact main commit SHA>.
# This is a non-secret build interlock, not a substitute for Independent Gate or branch protection.
