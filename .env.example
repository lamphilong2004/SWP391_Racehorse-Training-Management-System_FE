# Shared login, /me and logout always use this real backend origin.
VITE_API_BASE_URL=http://localhost:8080
# Keep all related Medical / Incident / Groom entities on one source.
# api: real HTTP only. demo: persistent local business data after real login.
VITE_MEDICAL_DATA_SOURCE=demo
VITE_DEMO_DELAY_MS=150
# Optional real GROOM user ID for initial sample assignments. If blank, bind seed
# assignments once to the first authenticated Groom who opens the demo.
VITE_DEMO_GROOM_USER_ID=
